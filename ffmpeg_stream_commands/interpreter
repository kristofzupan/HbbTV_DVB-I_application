#!/bin/sh
set -e

ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT="$ROOT/DVB-I-Reference-Client/stream/live/interpreter"
mkdir -p "$OUT"

exec ffmpeg -stream_loop -1 -fflags +genpts -re -i "$ROOT/video_content/interpreter.mp4" \
  -c:v libx264 -profile:v baseline -level 3.1 -preset veryfast \
  -vf "crop=1080:1080:420:0,scale=480:480,fps=25" -r 25 \
  -b:v 800k -maxrate 900k -bufsize 1600k -an \
  -f dash -format_options "movflags=+cmaf" -seg_duration 4 -g 100 -keyint_min 100 -sc_threshold 0 \
  -window_size 15 -use_template 1 -use_timeline 1 \
  -utc_timing_url "https://time.akamai.com/?iso" \
  -remove_at_exit 1 "$OUT/stream.mpd"
