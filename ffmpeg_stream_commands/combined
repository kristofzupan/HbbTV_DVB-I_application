#!/bin/sh
# Both signing channels, produced by one process from one source.
#
# Output 1 — stream/live/combined — main picture and sign-language interpreter
# as two video AdaptationSets in one manifest. The signer carries the DASH Role
# "sign" so the application can find it in band rather than being handed a
# second URL.
#
# Output 2 — stream/live/burned — the same programme with the signer composited
# into the picture as one ordinary video track. This is the conventional way
# signing is delivered — every deployment surveyed in DVB BlueBook A185 annex A
# does it this way — and it exists as the comparison case, not as a fallback.
#
# One process for both, rather than two, because a viewer switching between the
# channels should land at the same moment of the programme. Run separately they
# cannot: each ffmpeg sets its own availabilityStartTime and loops the source on
# its own phase, so the offset between the channels is whatever the gap between
# their two start times happened to be, and it changes every time either one
# restarts — in practice hours apart.
#
# With both outputs in one process the offset is bounded and small: the same
# decoded frame is sent to both encoders, so only availabilityStartTime can
# differ, and it differs only by how long each muxer took to write its first
# segment. Measured over two runs: 31 ms and 488 ms. Sub-second, but not frame
# accurate, and it varies from start to start — the burnt-in output encodes at
# ultrafast and reaches its first segment sooner. Do not quote a fixed figure.
#
# It also means the two channels can no longer drift apart, restart apart, or be
# deployed apart, and the source is decoded once instead of twice.
#
# The cost is a single failure domain: this process now carries all three
# channels, so anything that stops it stops all of them.
#
# The source is one file holding both video tracks, built by ./mux-source.
# Looping two separate inputs instead drifts: -stream_loop restarts each input
# independently and rebases its timestamps, so a per-loop rounding difference of
# a few milliseconds accumulates. At 249.8 s per loop that is ~350 loops a day,
# and after a week the signer is seconds away from the picture. The manifest
# never shows it — both tracks stay correctly timestamped, it is the content at
# a given timestamp that diverges. One input restarts all tracks together, so
# their alignment cannot drift no matter how long the encoder runs.
set -e

# Resolve the repository from this script's own location, so the same file works
# unchanged on a development machine and on the deployment host.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT_COMBINED="$ROOT/DVB-I-Reference-Client/stream/live/combined"
OUT_BURNED="$ROOT/DVB-I-Reference-Client/stream/live/burned"
SRC="$ROOT/video_content/source_combined.mp4"

if [ ! -f "$SRC" ]; then
  echo "Missing $SRC — build it first with: sh $(dirname "$0")/mux-source" >&2
  exit 1
fi

mkdir -p "$OUT_COMBINED" "$OUT_BURNED"

# The burnt-in channel runs at ultrafast where the overlay channel runs at
# veryfast, because the host cannot encode both in real time: with both at
# veryfast the encoder logged speed=0.999x with duplicated frames and published
# segments in bursts of two rather than one every four seconds, which stalled
# playback. So a viewer comparing the two channels is seeing a difference of
# encoder preset as well as a difference of approach, and at a fixed 3000k that
# is visible — ultrafast gives up B-frames, CABAC and most analysis. Do not draw
# quality conclusions across the channels while this stands.
#
# The fix is to stop encoding at run time at all: nothing in either stream
# changes between loops, so both could be pre-rendered once and stream-copied
# here, measured at 0.04 s of CPU to package a minute of content. That returns
# both channels to the same encode and removes the jitter at source.
#
# The signer is the second video track of the source, already cropped and scaled
# to 480x480 by ./mux-source. overlay places it top right with a 32 px margin,
# which is where the application puts it by default — the two channels are only
# a fair comparison if the signer is in the same place on both. The bottom of
# the screen is left to subtitles. shortest=0 keeps the main picture running if
# the signer track ever ends early.
exec ffmpeg \
  -stream_loop -1 -re -i "$SRC" \
  -filter_complex "[0:v:0][0:v:1]overlay=W-w-32:32:shortest=0[burn]" \
  \
  -map 0:v:0 -map 0:a:0 -map 0:v:1 \
  -c:v libx264 -preset veryfast -sc_threshold 0 -g 100 -keyint_min 100 \
  -profile:v:0 high     -level:v:0 4.0 -b:v:0 3000k -maxrate:v:0 3300k -bufsize:v:0 6000k \
  -profile:v:1 baseline -level:v:1 3.1 -b:v:1 800k  -maxrate:v:1 900k  -bufsize:v:1 1600k \
  -c:a aac -b:a 128k -ar 48000 \
  -f dash -format_options "movflags=+cmaf" -seg_duration 4 -window_size 15 -use_template 1 -use_timeline 1 \
  -utc_timing_url "https://time.akamai.com/?iso" \
  -adaptation_sets 'id=0,descriptor=<Role schemeIdUri="urn:mpeg:dash:role:2011" value="main"/>,streams=0 id=1,streams=1 id=2,descriptor=<Role schemeIdUri="urn:mpeg:dash:role:2011" value="sign"/>,streams=2' \
  -remove_at_exit 1 "$OUT_COMBINED/stream.mpd" \
  \
  -map "[burn]" -map 0:a:0 \
  -c:v libx264 -preset ultrafast -sc_threshold 0 -g 100 -keyint_min 100 \
  -profile:v high -level 4.0 -b:v 3000k -maxrate 3300k -bufsize 6000k \
  -c:a aac -b:a 128k -ar 48000 \
  -f dash -format_options "movflags=+cmaf" -seg_duration 4 -window_size 15 -use_template 1 -use_timeline 1 \
  -utc_timing_url "https://time.akamai.com/?iso" \
  -remove_at_exit 1 "$OUT_BURNED/stream.mpd"
