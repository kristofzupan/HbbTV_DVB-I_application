#!/bin/sh
set -e

ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT="$ROOT/DVB-I-Reference-Client/stream/live/main"
mkdir -p "$OUT"

exec ffmpeg -stream_loop -1 -fflags +genpts -re -i "$ROOT/video_content/main.mp4" \
  -c:v libx264 -profile:v high -level 4.0 -preset veryfast \
  -b:v 3000k -maxrate 3300k -bufsize 6000k \
  -g 100 -keyint_min 100 -sc_threshold 0 \
  -c:a aac -b:a 128k -ar 48000 \
  -f dash -format_options "movflags=+cmaf" -seg_duration 4 -window_size 15 -use_template 1 -use_timeline 1 \
  -utc_timing_url "https://time.akamai.com/?iso" \
  -remove_at_exit 1 "$OUT/stream.mpd"
