#!/bin/sh
# Build the two source files the loop is served from. Run once, whenever
# video_content changes. Nothing here runs at serving time.
#
# The programme is a fixed loop, so every frame that will ever be sent is known
# in advance. Encoding it live — twice over, forever — is what made the host run
# out of CPU: with both streams encoding at once the encoder logged speed=0.999x
# with duplicated frames and published segments in bursts, which stalled
# playback. Encoding once, offline, removes the constraint entirely and lets
# both channels use the same slow preset, so they are finally comparable to each
# other as well as cheaper to serve.
#
# LOOP_SECONDS = 248 is not a round number chosen for tidiness. It is the
# longest length under the source that is exact in all three units the stream is
# divided into:
#
#   248 s = 6200 video frames at 25 fps          (exact)
#         = 11625 AAC frames at 48 kHz / 1024    (exact)
#         = 62 segments of 4 s                   (exact)
#
# 249.8 s of video against 249.856 s of audio is where the subtitle drift came
# from: -stream_loop advances the timeline by the longest stream, so every loop
# put the cues 56 ms further out, and after 1670 loops they were 94 seconds
# away. Cutting both to a length that is exact in every unit means the loop
# restarts on a segment boundary with video, audio and subtitles all at zero
# together, and the drift cannot accumulate because there is nothing left over
# to accumulate. 252 s would not do: 11812.5 AAC frames is half a frame short.
set -e

ROOT=$(cd "$(dirname "$0")/.." && pwd)
IN_MAIN="$ROOT/video_content/main.mp4"
IN_SIGN="$ROOT/video_content/interpreter.mp4"
# The broadcaster's own version with the signer already in the picture, used as
# delivered for the burnt-in channel. Same edit and timing as main.mp4, so the
# subtitles fit both channels.
IN_BURNED="$ROOT/video_content/burned.mp4"
OUT_COMBINED="$ROOT/video_content/source_combined.mp4"
OUT_BURNED="$ROOT/video_content/source_burned.mp4"

# Overridable so the pipeline can be exercised end to end on a few seconds of
# content without waiting for a full encode. Any override has to satisfy the
# same three exactness conditions, so they are checked rather than assumed.
LOOP_SECONDS=${LOOP_SECONDS:-248}

WANT_VIDEO_FRAMES=$((LOOP_SECONDS * 25))
WANT_AUDIO_FRAMES=$((LOOP_SECONDS * 48000 / 1024))
if [ $((LOOP_SECONDS % 4)) -ne 0 ] || \
   [ $((WANT_AUDIO_FRAMES * 1024)) -ne $((LOOP_SECONDS * 48000)) ]; then
  echo "LOOP_SECONDS=$LOOP_SECONDS is not exact in all three units:" >&2
  echo "  needs to divide by 4 (segments) and by 1024/48000 (AAC frames)" >&2
  exit 2
fi

for f in "$IN_MAIN" "$IN_SIGN" "$IN_BURNED"; do
  [ -f "$f" ] || { echo "Missing $f" >&2; exit 1; }
done

# -g 100 with -keyint_min 100 and -sc_threshold 0 puts an IDR exactly every 4 s
# and nowhere else, which is what lets the packager cut segments on keyframes
# without re-encoding, and what lets the loop restart on a segment boundary.
#
# -preset slow because this runs once and nothing is waiting for it. The live
# encoders had to use veryfast and ultrafast to keep up; at the same bitrate
# this is better than either, and identical across both channels.
#
# The signer track is the exception, and -refs:v:1 1 below is why. It is not
# decoded by the television: an application decodes it in JavaScript, through
# Broadway, so its cost is paid frame by frame in a software decoder rather than
# in silicon. -preset slow raises x264's reference frames from 1 to 5, which the
# hardware decoder handling the picture does not notice and Broadway very much
# does — it stuttered every few seconds until this was pinned back. The profile
# is already constrained to Baseline for the same decoder, so this is the same
# concession applied to the same constraint.
GOP="-g 100 -keyint_min 100 -sc_threshold 0"
PRESET=${PRESET:-"-preset slow"}

# The studio green behind the signer is replaced with one flat colour, so the
# application can key it out on the television and show the signer without a
# box. SIGNER_BG=studio keeps the original background, for comparison. The studio green is pale and unevenly lit (#88c083 at
# the top, #6ca468 at the bottom corners), and the black jacket sits close to
# it in chroma: a key loose enough to take the whole background on the
# television also takes the jacket. Keying here, once, with a tight threshold
# and despill, leaves the television a single known colour to remove.
#
# 0x00b140 is the colour the application's shader keys on. It encodes as
# Y 129, U 96, V 55 (limited-range BT.709, which the source is tagged with);
# the shader holds those U/V values. Change both together or not at all.
#
# Only the combined source is affected: the burnt-in channel is the
# broadcaster's own picture.
SIGN_FILTER="crop=1080:1080:420:0,scale=480:480,fps=25"
SIGNER_BG=${SIGNER_BG:-flat}
if [ "$SIGNER_BG" = "flat" ]; then
  SIGN_CHAIN="[1:v]$SIGN_FILTER,format=yuva420p,chromakey=0x7cb679:0.05:0.03,despill=type=green[key];color=c=0x00b140:s=480x480:r=25[bg];[bg][key]overlay=shortest=1,format=yuv420p[sign]"
else
  SIGN_CHAIN="[1:v]$SIGN_FILTER[sign]"
fi

echo "== Building $OUT_COMBINED (main + signer as separate tracks, signer background: $SIGNER_BG)"
ffmpeg -y -loglevel warning \
  -i "$IN_MAIN" -i "$IN_SIGN" \
  -filter_complex "$SIGN_CHAIN" \
  -map 0:v:0 -map 0:a:0 -map "[sign]" \
  -t "$LOOP_SECONDS" \
  -c:v libx264 $PRESET $GOP -pix_fmt yuv420p \
  -profile:v:0 high     -level:v:0 4.0 -b:v:0 3000k -maxrate:v:0 3300k -bufsize:v:0 6000k \
  -profile:v:1 baseline -level:v:1 3.1 -b:v:1 800k  -maxrate:v:1 900k  -bufsize:v:1 1600k \
  -refs:v:1 1 \
  -c:a aac -b:a 128k -ar 48000 -ac 2 \
  -movflags +faststart \
  "$OUT_COMBINED"

# The burnt-in channel is the broadcaster's version as delivered: picture
# reduced to the top left, signer on the right. Its layout is theirs, not the
# application's default, which is the point — it is what a viewer gets today.
# It is still re-encoded, not copied: the loop needs the same 4 s GOP, bitrate
# and exact length as the combined source.
echo "== Building $OUT_BURNED (broadcaster's version with signer)"
ffmpeg -y -loglevel warning \
  -i "$IN_BURNED" \
  -map 0:v:0 -map 0:a:0 \
  -t "$LOOP_SECONDS" \
  -c:v libx264 $PRESET $GOP -pix_fmt yuv420p \
  -profile:v high -level 4.0 -b:v 3000k -maxrate 3300k -bufsize 6000k \
  -c:a aac -b:a 128k -ar 48000 -ac 2 \
  -movflags +faststart \
  "$OUT_BURNED"

# A length that is off by even one frame breaks the property the whole design
# rests on, and it would not be visible until the cues had drifted for a day.
echo "== Verifying"
fail=0
for f in "$OUT_COMBINED" "$OUT_BURNED"; do
  v=$(ffprobe -v error -select_streams v:0 -count_frames \
        -show_entries stream=nb_read_frames -of csv=p=0 "$f" | tr -d '\r,')
  a=$(ffprobe -v error -select_streams a:0 -count_frames \
        -show_entries stream=nb_read_frames -of csv=p=0 "$f" | tr -d '\r,')
  printf '  %-28s video %s frames (want %s), audio %s frames (want %s)\n' \
         "$(basename "$f")" "$v" "$WANT_VIDEO_FRAMES" "$a" "$WANT_AUDIO_FRAMES"
  [ "$v" = "$WANT_VIDEO_FRAMES" ] || { echo "    FAIL: video frame count" >&2; fail=1; }
  [ "$a" = "$WANT_AUDIO_FRAMES" ] || { echo "    FAIL: audio frame count" >&2; fail=1; }
done
[ "$fail" = "0" ] || exit 1
echo "  ok — both sources are exactly $LOOP_SECONDS s"
