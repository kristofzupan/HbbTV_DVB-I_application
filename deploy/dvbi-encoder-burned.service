# Runs the burnt-in-signer DASH encoder as a supervised service.
#
# Optional: only needed to serve the second ServiceInstance of channel 3, the
# comparison case against the application overlay. Without it that instance
# points at a manifest that does not exist; the channel still works, because
# clients take the lower priority number and get the overlay instance.
#
# Install:
#   sudo cp deploy/dvbi-encoder-burned.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dvbi-encoder-burned
#   systemctl status dvbi-encoder-burned
#
# Restart=always matters: ffmpeg runs with -remove_at_exit, so when it stops it
# deletes every segment and the channel goes black with nothing to bring it back.

[Unit]
Description=DVB-I burnt-in signer DASH encoder (comparison stream)
After=network.target

[Service]
Type=simple
User=administrator
WorkingDirectory=/srv/dvbi/HbbTV_DVB-I_application
ExecStart=/bin/sh ffmpeg_stream_commands/burned
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
